# =============================================================================
# Context Intelligence Framework (CIF) - Environment Configuration Template
# =============================================================================
# Copy this file to .env for local configuration.
# DO NOT commit real secrets or API keys into git. .env is excluded via .gitignore.
# =============================================================================

# --- Server & Network Security ---
# Host bind address: 127.0.0.1 for local only, 0.0.0.0 for containerized deployment
CIF_BIND=127.0.0.1
PORT=8080

# Restrict network calls to local disk only (1 = offline/airgapped mode)
CIF_LOCAL_ONLY=0

# Development mode flag (1 = allow localhost CORS, 0 = strict production mode)
CIF_DEV_MODE=1

# Allowed CORS origins for production (comma-separated URLs)
CIF_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional custom CA bundle path for strict enterprise TLS verification
# CIF_CA_BUNDLE=/path/to/custom/ca-bundle.pem

# --- Role-Based Access Control Tokens ---
# Required for write/destructive API endpoints (/api/review-queue/*, /api/reseed, etc.)
CIF_ADMIN_TOKEN=
CIF_REVIEWER_TOKEN=

# --- GitHub Integration ---
# GitHub Personal Access Token or App Token (for fetching public/private repo diffs & PRs)
GITHUB_TOKEN=

# GitHub App Webhook HMAC Secret (used to verify X-Hub-Signature-256 on /api/webhook/github)
CIF_WEBHOOK_SECRET=

# --- LLM Baseline & Extraction (Optional) ---
# When unset, CIF uses the built-in deterministic heuristic extractor
# Set these only if evaluating against external LLM providers
CIF_LLM_PROVIDER=openai
CIF_LLM_API_KEY=
CIF_LLM_MODEL=

# --- Privacy & Sanitization ---
# Redact emails and phone numbers during ingestion (1 = enabled, 0 = disabled)
CIF_REDACT_PII=0

# Anonymize commit and PR author handles to [REDACTED:AUTHOR]
CIF_REDACT_AUTHOR=0
